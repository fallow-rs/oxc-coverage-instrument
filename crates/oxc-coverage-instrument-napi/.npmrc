# Network resilience for CI installs. The release matrix runs `npm ci` across
# seven platform runners; a single transient registry reset (ECONNRESET) on any
# one of them fails the build and skips the npm publish. These retry/backoff
# settings make the install ride out transient blips instead. Only fetch tuning
# lives here; registry auth / OIDC trusted-publishing config is provided by the
# release workflow and is not committed.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
